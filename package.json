{
  "name": "civaria-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "check-jsdoc": "tsx scripts/check-jsdoc-coverage.ts",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "check:parity": "node scripts/check-runtime-parity.mjs",
    "check:ssr": "node scripts/check-ssr-imports.mjs",
    "check:fixtures": "node scripts/check-runtime-fixtures.mjs",
    "verify:runtimes": "pnpm check:boundaries && pnpm build && pnpm check:parity && pnpm check:ssr && pnpm check:fixtures",
    "check:brand": "node scripts/check-civaria-legacy.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lightningcss-cli"
    ],
    "packageExtensions": {
      "tiptap-markdown": {
        "peerDependencies": {
          "@tiptap/pm": "^3.0.0"
        }
      }
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.29",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9",
    "typescript": "^5.8",
    "vitest": "^4.1"
  }
}
