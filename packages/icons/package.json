{
  "name": "@weiui/icons",
  "version": "0.0.1",
  "description": "Framework-neutral WeiUI icon data with generated React, Vue, Solid, Svelte and SVG adapters.",
  "author": "WeiUI Contributors",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "homepage": "https://ui.wei-dev.com/",
  "repository": { "type": "git", "url": "https://github.com/xiaooye/weiui.git", "directory": "packages/icons" },
  "bugs": { "url": "https://github.com/xiaooye/weiui/issues" },
  "keywords": ["icons", "svg", "weiui", "react", "vue", "solid", "svelte", "framework-neutral", "tree-shakable"],
