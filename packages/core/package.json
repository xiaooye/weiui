{
  "name": "@weiui/core",
  "version": "0.1.0",
  "description": "Framework-neutral WeiUI behavior, accessibility, anatomy, state and metadata runtime.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./anatomy": { "types": "./dist/anatomy.d.ts", "import": "./dist/anatomy.js" },
    "./controllers": { "types": "./dist/controllers.d.ts", "import": "./dist/controllers.js" },
    "./dom": { "types": "./dist/dom.d.ts", "import": "./dist/dom.js" },
    "./registry": { "types": "./dist/registry.d.ts", "import": "./dist/registry.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run src/__tests__",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  }
}
