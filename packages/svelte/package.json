{
  "name": "@weiui/svelte",
  "version": "0.1.0",
  "description": "Native Svelte 5 runtime for the WeiUI design system.",
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "svelte": "./dist/index.js", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": { "build": "node ./scripts/build.mjs", "test": "node ./scripts/contract-test.mjs", "typecheck": "node --check ./src/index.js && node --check ./src/internal.js" },
  "dependencies": { "@weiui/core": "workspace:*", "@weiui/css": "workspace:*" },
  "peerDependencies": { "svelte": "^5.0.0" },
  "peerDependenciesMeta": { "svelte": { "optional": true } }
}
