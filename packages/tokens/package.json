{
  "name": "@civaria/tokens",
  "version": "0.1.0",
  "description": "Civaria design tokens — W3C Design Tokens Community Group JSON source-of-truth exported as CSS custom properties and TypeScript.",
  "author": "Civaria Contributors",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "homepage": "https://ui.wei-dev.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaooye/weiui.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/xiaooye/weiui/issues"
  },
  "keywords": [
    "design-tokens",
    "tokens",
    "civaria",
    "oklch",
    "w3c",
    "css-custom-properties",
    "design-system"
  ],
  "type": "module",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "validate": "tsx scripts/validate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@civaria/a11y": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19",
    "vitest": "^4.1"
  }
}
