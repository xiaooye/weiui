{
  "name": "@civaria/css",
  "version": "0.1.0",
  "description": "Civaria CSS layer — zero-JavaScript component styles built on design tokens with logical properties, OKLCH colors, and WCAG AAA contrast.",
  "author": "Civaria Contributors",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "homepage": "https://ui.wei-dev.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaooye/weiui.git",
    "directory": "packages/css"
  },
  "bugs": {
    "url": "https://github.com/xiaooye/weiui/issues"
  },
  "keywords": [
    "css",
    "design-system",
    "civaria",
    "tokens",
    "oklch",
    "logical-properties",
    "cascade-layers",
    "wcag-aaa"
  ],
  "bin": {
    "civaria-css": "./dist/config-cli.mjs"
  },
  "exports": {
    ".": "./dist/civaria.css",
    "./civaria.css": "./dist/civaria.css",
    "./reset.css": "./dist/reset.css",
    "./base.css": "./dist/base.css",
    "./a11y/*": "./dist/a11y/*",
    "./elements/*": "./dist/elements/*",
    "./utilities/*": "./dist/utilities/*",
    "./bundle-manifest.json": "./dist/bundle-manifest.json",
    "./config": "./dist/config.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test-build.mjs"
  },
  "devDependencies": {
    "postcss": "^8.5",
    "postcss-cli": "^11.0",
    "postcss-import": "^16.1",
    "postcss-nesting": "^13.0",
    "lightningcss-cli": "^1.33"
  }
}
